<!-- Notifications page template -->
<!DOCTYPE html>
<html>
<head>
    <!-- Page title -->
    <title>Notifications</title>
</head>
<body>

<!-- Main heading -->
<h1>Your Notifications</h1>

<!-- Loop through notifications if they exist -->
<% if (Array.isArray(notifications)) { %>
    <% notifications.forEach(n => { %>
        <div>
            <!-- Display notification message and timestamp -->
            <p><%= n.message %></p>
            <small><%= n.created_at %></small>
        </div>
    <% }) %>
<% } else { %>
    <!-- Fallback if no notifications -->
    <p>No notifications found.</p>
<% } %>

<!-- JavaScript to update notification dot -->
<script>
fetch('/notifications/unread-count')
    .then(res => res.json())
    .then(data => {
        const dot = document.getElementById('notification-dot');
        if (!dot) return;

        if (data.count > 0) {
            dot.classList.remove('hidden');
        } else {
            dot.classList.add('hidden');
        }
    })
    .catch(err => console.error('Notification dot error:', err));
</script>

<!-- Link back to home -->
<a href="/">Back to home</a>

</body>
</html>